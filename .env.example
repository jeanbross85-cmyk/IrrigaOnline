APP_NAME=Agente de Irrigacao
# PostgreSQL centralizado: troque usuario, senha, host, porta e nome do banco.
DATABASE_URL=postgresql+psycopg://irrigacao_user:ALTERE_SENHA@localhost:5432/irrigacao
# Gere uma chave forte e exclusiva antes de hospedar. Nunca use a chave de exemplo em produção.
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA_E_SECRETA
# Defina true somente quando a aplicação estiver servida por HTTPS.
COOKIE_SECURE=false
ALTITUDE_M=220
ALTURA_VENTO_M=2
EFICIENCIA_SISTEMA=0.90
VAZAO_EMISSOR_LH=0.98
EMISSORES_POR_PLANTA=3
ESPACAMENTO_LINHAS_M=1.00
ESPACAMENTO_PLANTAS_M=0.50
